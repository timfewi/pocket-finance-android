<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- External camera and Photo Picker need no app CAMERA or storage permission. -->
    <queries>
        <intent><action android:name="android.media.action.IMAGE_CAPTURE" /></intent>
    </queries>
    <application>
        <provider
            android:name="dev.pocketfinance.receiptcapture.ReceiptFileProvider"
            android:authorities="${applicationId}.receiptcapture.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/receipt_capture_paths" />
        </provider>
    </application>
</manifest>
